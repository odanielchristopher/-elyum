{
  "name": "@elyum/fastify",
  "version": "0.1.0",
  "description": "Native Fastify adapter for Elyum controllers",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.mjs",
    "dist/index.d.ts",
    "dist/index.d.mts"
  ],
  "scripts": {
    "lint": "eslint src tests",
    "format:check": "prettier --check src tests",
    "ci:lint": "pnpm run lint && pnpm run format:check",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --tsconfig tsconfig.build.json",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@elyum/core": "workspace:*",
    "@elyum/http": "workspace:*",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "fastify": "^5.12.1",
    "reflect-metadata": "^0.1.13"
  },
  "peerDependencies": {
    "fastify": "^5.0.0",
    "reflect-metadata": "^0.1.13"
  }
}
