{
  "name": "@elyum/validation-zod",
  "version": "0.1.0",
  "description": "Zod adapter for Elyum validation",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.mjs",
    "dist/index.d.ts",
    "dist/index.d.mts"
  ],
  "scripts": {
    "lint": "eslint src tests",
    "format:check": "prettier --check src tests",
    "ci:lint": "pnpm run lint && pnpm run format:check",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --tsconfig tsconfig.build.json",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "elyum",
    "validation",
    "zod",
    "adapter"
  ],
  "dependencies": {
    "@elyum/validation": "workspace:*"
  },
  "devDependencies": {
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "zod": "^4.5.4"
  }
}
