{
  "name": "@elyum/express",
  "version": "0.1.0",
  "description": "Native Express adapter for Elyum controllers",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.mjs",
    "dist/index.d.ts",
    "dist/index.d.mts"
  ],
  "scripts": {
    "lint": "eslint src tests examples/main.ts scripts",
    "format:check": "prettier --check src tests examples scripts README.md",
    "ci:lint": "pnpm run lint && pnpm run format:check",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --tsconfig tsconfig.build.json",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest --coverage",
    "example:build": "tsc -p examples/tsconfig.json",
    "example:start": "node dist/example/main.js",
    "test:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@elyum/core": "workspace:*",
    "@elyum/http": "workspace:*",
    "@elyum/validation": "workspace:*",
    "@types/express": "5.0.6"
  },
  "devDependencies": {
    "@elyum/validation-yup": "workspace:*",
    "express": "5.3.0",
    "reflect-metadata": "^0.1.13",
    "yup": "^1.7.1"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "reflect-metadata": "^0.1.13"
  }
}
