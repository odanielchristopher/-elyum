{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@elyum/contracts/*": ["./src/contracts/*"],
      "@elyum/types/*": ["./src/types/*"],
      "@elyum/errors/*": ["./src/errors/*"],
      "@elyum/tests/*": ["./tests/*"]
    }
  },
  "include": ["src", "tests"]
}
