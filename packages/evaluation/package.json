{
  "name": "@elyum/evaluation",
  "version": "0.1.0",
  "private": true,
  "description": "Reference applications for Elyum",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch-path=applications/elyum-fastify/src --watch-preserve-output --run dev:serve",
    "dev:serve": "tsc -b && pnpm start",
    "format:check": "prettier --check applications tests scripts manifests README.md",
    "lint": "eslint applications tests scripts",
    "start": "node --enable-source-maps dist/elyum-fastify/src/main.js",
    "test": "vitest",
    "test:ci": "vitest run && pnpm test:boundaries && pnpm test:manifests && pnpm check:boundaries && pnpm check:manifests",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "pretest:ci": "pnpm --filter @elyum/evaluation... build",
    "pretest": "pnpm --filter @elyum/evaluation... build",
    "test:boundaries": "node scripts/boundaries-cases.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:manifests": "node scripts/manifests.mjs",
    "check:origins": "node scripts/manifests.mjs --verify-origins",
    "manifests:update": "node scripts/manifests.mjs --write",
    "pretest:coverage": "pnpm --filter @elyum/evaluation... build",
    "start:ef": "node --enable-source-maps dist/elyum-fastify/src/main.js",
    "start:fn": "node --enable-source-maps dist/fastify-native/src/main.js",
    "start:ee": "node --enable-source-maps dist/elyum-express/src/main.js",
    "start:en": "node --enable-source-maps dist/express-native/src/main.js",
    "test:manifests": "node scripts/manifests-cases.mjs"
  },
  "dependencies": {
    "@elyum/core": "workspace:*",
    "@elyum/express": "workspace:*",
    "@elyum/fastify": "workspace:*",
    "@elyum/http": "workspace:*",
    "@elyum/validation": "workspace:*",
    "@elyum/validation-zod": "workspace:*",
    "@types/express": "5.0.6",
    "express": "5.3.0",
    "fastify": "^5.12.3",
    "reflect-metadata": "^0.1.13",
    "zod": "^4.5.4"
  }
}
