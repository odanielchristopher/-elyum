{
  "name": "@elyum/evaluation",
  "version": "0.1.0",
  "private": true,
  "description": "Reference applications for Elyum",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch-path=src --watch-preserve-output --run dev:serve",
    "dev:serve": "tsc -b && node --enable-source-maps dist/main.js",
    "format:check": "prettier --check src tests",
    "lint": "eslint src tests",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@elyum/core": "workspace:*",
    "@elyum/fastify": "workspace:*",
    "@elyum/http": "workspace:*",
    "@elyum/validation": "workspace:*",
    "@elyum/validation-yup": "workspace:*",
    "@elyum/validation-zod": "workspace:*",
    "fastify": "^5.12.3",
    "reflect-metadata": "^0.1.13",
    "yup": "^1.7.1",
    "zod": "^4.5.4"
  }
}
