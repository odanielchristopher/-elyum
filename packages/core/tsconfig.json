{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@elyum/di/*": ["./src/di/*"],
      "@elyum/context/*": ["./src/context/*"],
      "@elyum/types/*": ["./src/types/*"],
      "@elyum/errors/*": ["./src/errors/*"],
      "@elyum/decorators/*": ["./src/decorators/*"],
      "@elyum/lifecycle/*": ["./src/lifecycle/*"],
      "@elyum/metadata/*": ["./src/metadata/*"],
      "@elyum/helpers/*": ["./src/helpers/*"],
      "@elyum/tests/*": ["./tests/*"]
    }
  },
  "include": ["src"]
}
