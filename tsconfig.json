{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@elyum/validation": ["./packages/validation/src"],
      "@elyum/validation-zod": ["./packages/validation-zod/src"],
      "@elyum/validation-yup": ["./packages/validation-yup/src"],
      "@elyum/core": ["./packages/core/src"],
      "@elyum/http": ["./packages/http/src"],
      "@elyum/fastify": ["./packages/fastify/src"],
      "@elyum/express": ["./packages/express/src"]
    }
  },
  "include": ["apps/**/*", "packages/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "./packages/express/tsconfig.json"
    },
    {
      "path": "./packages/core/tsconfig.json"
    },
    {
      "path": "./packages/http/tsconfig.json"
    },
    {
      "path": "./packages/fastify/tsconfig.json"
    },
    {
      "path": "./packages/validation/tsconfig.json"
    },
    {
      "path": "./packages/validation-zod/tsconfig.json"
    },
    {
      "path": "./packages/validation-yup/tsconfig.json"
    },
    {
      "path": "./packages/evaluation/tsconfig.json"
    }
  ]
}
