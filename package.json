{
  "name": "elyum",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "description": "",
  "scripts": {
    "prepare": "husky install",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "format:check": "pnpm -r run format:check",
    "ci:lint": "pnpm lint && pnpm format:check",
    "pretypecheck": "tsc -b packages/core packages/http packages/fastify packages/express packages/validation packages/validation-zod packages/validation-yup packages/examples --pretty false",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:ts6": "tsc6 -b packages/core packages/http packages/fastify packages/express packages/validation packages/validation-zod packages/validation-yup packages/examples --pretty false",
    "test:ci": "pnpm -r run test:ci",
    "test:coverage": "pnpm -r run test:coverage",
    "test": "pnpm -r run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.27.0",
    "@types/node": "^25.2.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^16.2.0",
    "husky": "^8.0.3",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.18"
  }
}
